# Copy to .env (git-ignored) and fill in. Without keys the API serves
# badged mock/fallback output so the UI stays explorable.
META_LLAMA_API_KEY=
MUSE_IMAGE_API_KEY=
REPLICATE_API_TOKEN=
RAWG_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
HUGGINGFACE_API_KEY=
# Comma-separated extra dashboard origins allowed by CORS
# (localhost:3000 is always allowed). Example:
# ALLOW_ORIGINS=https://gdd-builder.vercel.app
ALLOW_ORIGINS=
# Abuse caps on billed POST /api/v1/* per client IP (BYOK bypasses both)
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_PER_DAY=300
# Emergency kill-switch: 1 pauses all server-key spend (BYOK still works)
# BILLING_PAUSED=1
