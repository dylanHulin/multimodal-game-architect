# Copy to .env (git-ignored) and fill in. Without keys the API serves
# badged mock/fallback output so the UI stays explorable.
META_LLAMA_API_KEY=
MUSE_IMAGE_API_KEY=
REPLICATE_API_TOKEN=
RAWG_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
HUGGINGFACE_API_KEY=
# Comma-separated extra dashboard origins allowed by CORS
# (localhost:3000 is always allowed). Example:
# ALLOW_ORIGINS=https://gdd-builder.vercel.app
ALLOW_ORIGINS=
